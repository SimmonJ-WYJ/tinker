{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "sessionId": {
      "type": "string",
      "maxLength": 64
    },
    "kind": {
      "type": "string",
      "const": "implicit_feedback"
    },
    "action": {
      "type": "string",
      "enum": [
        "copy",
        "save",
        "cite",
        "discard",
        "thumbs_up",
        "thumbs_down",
        "retry"
      ]
    },
    "target": {
      "type": "string",
      "maxLength": 64
    }
  },
  "required": [
    "ts",
    "kind",
    "action"
  ],
  "additionalProperties": false
}
