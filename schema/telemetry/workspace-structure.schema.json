      "maximum": 9007199254740991
    },
    "sessionId": {
      "type": "string",
      "maxLength": 64
    },
    "kind": {
      "type": "string",
      "const": "workspace_structure"
    },
    "workspaceHash": {
      "type": "string",
      "maxLength": 64
    },
    "sessionCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "paperCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "noteCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "ts",
    "kind"
  ],
  "additionalProperties": false
}
