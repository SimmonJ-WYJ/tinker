{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "sessionId": {
      "type": "string",
      "maxLength": 64
    },
    "kind": {
      "type": "string",
      "const": "error_event"
    },
    "stage": {
      "type": "string",
      "maxLength": 64
    },
    "message": {
      "type": "string",
      "maxLength": 512
    },
    "retryable": {
      "type": "boolean"
    }
  },
  "required": [
    "ts",
    "kind",
    "stage"
  ],
  "additionalProperties": false
}
