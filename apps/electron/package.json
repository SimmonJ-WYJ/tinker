{
  "name": "@asci/electron",
  "version": "0.1.607",
  "description": "Tinker — adaptive AI agents",
  "main": "dist/main.cjs",
  "author": {
    "name": "ErlichLiu",
    "email": "erlichliu@gmail.com"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ELECTRON_RUN_AS_NODE= concurrently -k -n vite,electron -c blue,green \"bun run dev:vite\" \"bun run dev:electron\"",
    "dev:split": "bash scripts/dev-split.sh",
    "dev:vite": "vite dev",
    "dev:kill": "bun run scripts/dev-kill.ts",
    "dev:electron": "bun run dev:kill && bun run stage:runtimes && bun run build:main && bun run build:preload && bun run build:resources && bun run scripts/sleep.ts 2 && concurrently -k -n main,preload,app -c yellow,magenta,cyan \"bun run watch:main\" \"bun run watch:preload\" \"ASCI_RENDERER_MODE=dev bunx electronmon .\"",
    "build:main": "bun run scripts/build-main.ts",
    "build:preload": "esbuild src/preload/index.ts --bundle --platform=node --format=cjs --outfile=dist/preload.cjs --external:electron",
    "eval:rag": "esbuild scripts/rag-eval.ts --bundle --platform=node --format=cjs --outfile=dist/rag-eval.cjs --external:electron --external:@vscode/ripgrep --external:better-sqlite3 --external:bindings --external:sqlite-vec --external:onnxruntime-node --loader:.sql=text && ASCI_DEV=1 ELECTRON_RUN_AS_NODE=1 electron dist/rag-eval.cjs",
    "reindex:rag": "esbuild scripts/rag-reindex.ts --bundle --platform=node --format=cjs --outfile=dist/rag-reindex.cjs --external:electron --external:better-sqlite3 --external:bindings --external:sqlite-vec --external:onnxruntime-node --loader:.sql=text && ASCI_DEV=1 ELECTRON_RUN_AS_NODE=1 electron dist/rag-reindex.cjs",
    "eval:rag:jsonl": "esbuild scripts/rag-eval.ts --bundle --platform=node --format=cjs --outfile=dist/rag-eval.cjs --external:electron --external:@vscode/ripgrep --external:better-sqlite3 --external:bindings --external:sqlite-vec --external:onnxruntime-node --loader:.sql=text && ASCI_DEV=1 ELECTRON_RUN_AS_NODE=1 electron dist/rag-eval.cjs --file scripts/rag-eval-queries.txt --jsonl ../../docs/superpowers/rag-eval-runs",
    "eval:rag:full": "bun run reindex:rag && bun run eval:rag:jsonl",
    "eval:vec:build": "esbuild scripts/eval-vectorization.ts --bundle --platform=node --format=cjs --outfile=dist/eval-vectorization.cjs --external:electron --external:better-sqlite3 --external:bindings --external:sqlite-vec --external:onnxruntime-node --external:pdfjs-dist --loader:.sql=text",
    "eval:vec:index": "bun run eval:vec:build && ASCI_DEV=1 ELECTRON_RUN_AS_NODE=1 electron dist/eval-vectorization.cjs index",
    "eval:vec:replay": "bun run eval:vec:build && ASCI_DEV=1 ELECTRON_RUN_AS_NODE=1 electron dist/eval-vectorization.cjs replay",
    "eval:vec:compare": "bun run eval:vec:build && ASCI_DEV=1 ELECTRON_RUN_AS_NODE=1 electron dist/eval-vectorization.cjs compare",
    "watch:main": "bun run scripts/build-main.ts --watch",
    "watch:preload": "esbuild src/preload/index.ts --bundle --platform=node --format=cjs --outfile=dist/preload.cjs --external:electron --watch=forever",
    "build:renderer": "vite build",
    "build:zotero-mcp": "mkdir -p dist/resources/zotero-mcp && esbuild resources/zotero-mcp/server.ts --bundle --platform=node --format=cjs --outfile=dist/resources/zotero-mcp/server.cjs --external:pdf-parse --external:word-extractor --external:officeparser",
    "build:ocr-mcp": "mkdir -p dist/resources/ocr-mcp && esbuild resources/ocr-mcp/server.ts --bundle --platform=node --format=cjs --outfile=dist/resources/ocr-mcp/server.cjs --external:sharp --external:onnxruntime-node --external:paddleocr",
    "build:asr-mcp": "mkdir -p dist/resources/asr-mcp && esbuild resources/asr-mcp/server.ts --bundle --platform=node --format=cjs --outfile=dist/resources/asr-mcp/server.cjs --external:sherpa-onnx-node --external:ffmpeg-static",
    "build:runtimes": "bun run scripts/build-runtimes.ts",
    "setup:runtimes": "bun run scripts/setup-runtimes.ts",
    "build:workspace-papers-mcp": "mkdir -p dist/resources/workspace-papers-mcp && esbuild resources/workspace-papers-mcp/server.ts --bundle --platform=node --format=cjs --outfile=dist/resources/workspace-papers-mcp/server.cjs",
    "build:pdf-parser-mcp": "mkdir -p dist/resources/pdf-parser-mcp && esbuild resources/pdf-parser-mcp/server.ts --bundle --platform=node --format=cjs --outfile=dist/resources/pdf-parser-mcp/server.cjs --external:pdf-parse",
    "build:optional-python": "esbuild resources/optional-python/launcher.ts --bundle --platform=node --format=cjs --outfile=dist/resources/optional-python-launcher.cjs",
    "build:resources": "rm -rf dist/resources && mkdir -p dist/resources && bun run build:zotero-mcp && bun run build:ocr-mcp && bun run build:asr-mcp && bun run build:workspace-papers-mcp && bun run build:pdf-parser-mcp && bun run build:optional-python && cp -R resources/paddleocr dist/resources/paddleocr && cp resources/icon.* dist/resources/ && cp -R resources/asci-logos dist/resources/asci-logos",
    "build": "bun run build:main && bun run build:preload && bun run build:renderer && bun run build:resources",
    "start": "bun run build && bunx electron .",
    "typecheck": "tsc --noEmit",
    "rebuild": "bun run scripts/rebuild-better-sqlite3.ts",
    "generate:icons": "cd resources && ./generate-icons.sh",
    "fetch:python-runtime": "bun run ../../scripts/download-python-runtime.ts",
    "stage:runtimes": "bun run scripts/build-runtimes.ts -- --from-manifest scripts/runtimes-manifest.json",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:mac": "bun run stage:runtimes && ASCI_PY_TARGET=$(node -e \"process.stdout.write(process.platform + '-' + process.arch)\") electron-builder --mac",
    "dist:win": "bun run stage:runtimes && ASCI_PY_TARGET=$(node -e \"process.stdout.write(process.platform + '-' + process.arch)\") electron-builder --win",
    "dist:linux": "bun run stage:runtimes && ASCI_PY_TARGET=$(node -e \"process.stdout.write(process.platform + '-' + process.arch)\") electron-builder --linux",
    "dist:visual": "bun run scripts/dist.ts",
    "dist:fast": "bun run stage:runtimes && ASCI_PY_TARGET=$(node -e \"process.stdout.write(process.platform + '-' + process.arch)\") bun run scripts/dist.ts --current-arch --pkg",
    "dist:debug": "bun run scripts/dist.ts --current-arch --verbose"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.2.119",
    "@huggingface/tokenizers": "0.1.3",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@sentry/electron": "7.13.0",
    "@tanstack/react-virtual": "^3.13.24",
    "@types/dompurify": "^3.2.0",
    "@vscode/ripgrep": "1.15.14",
    "ajv": "^8.20.0",
    "better-sqlite3": "^12.10.0",
    "chokidar": "3.6.0",
    "d3-force": "3.0.0",
    "dayjs": "1.11.21",
    "dompurify": "^3.4.5",
    "fflate": "^0.8.3",
    "ffmpeg-static": "^5.3.0",
    "morphicons": "2.0.0",
    "onnxruntime-node": "^1.24.3",
    "paddleocr": "^1.1.1",
    "papaparse": "^5.5.3",
    "pdfjs-dist": "^5.6.205",
    "react-force-graph-2d": "1.29.1",
    "sharp": "^0.34.5",
    "sherpa-onnx-node": "^1.12.39",
    "sqlite-vec": "0.1.9",
    "tar": "^7.5.13",
    "thinking-orbs": "0.3.2",
    "unbzip2-stream": "^1.4.3"
  },
  "devDependencies": {
    "@asci/core": "workspace:*",
    "@asci/shared": "workspace:*",
    "@asci/ui": "workspace:*",
    "@electron/rebuild": "^4.0.4",
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "@happy-dom/global-registrator": "20.9.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-symbols/icons": "^1.3.1",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@tiptap/extension-code-block-lowlight": "^3.19.0",
    "@tiptap/extension-link": "^3.19.0",
    "@tiptap/extension-mention": "^3.19.0",
    "@tiptap/extension-placeholder": "^3.19.0",
    "@tiptap/extension-underline": "^3.19.0",
    "@tiptap/pm": "^3.19.0",
    "@tiptap/react": "^3.19.0",
    "@tiptap/starter-kit": "^3.19.0",
    "@tiptap/suggestion": "^3.19.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^22.0.0",
    "@types/papaparse": "^5.5.2",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/tar": "^7.0.87",
    "@types/unbzip2-stream": "^1.4.3",
    "@types/word-extractor": "1.0.6",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "electron": "^39.5.1",
    "electron-builder": "^25.1.8",
    "electron-updater": "^6.7.3",
    "electronmon": "^2.0.4",
    "esbuild": "^0.28.1",
    "happy-dom": "20.9.0",
    "i18next": "^26.0.0",
    "katex": "^0.16",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.460.0",
    "officeparser": "4.2.0",
    "pdf-parse": "1.1.1",
    "postcss": "^8.4.49",
    "postcss-import": "15.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.5.5",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.0.0",
    "undici": "^7.28.0",
    "use-stick-to-bottom": "^1.1.2",
    "vite": "^6.4.3",
    "word-extractor": "1.0.4",
    "zod": "^4.0.0"
  },
  "electronmon": {
    "patterns": [
      "dist/main.cjs",
      "dist/preload.cjs",
      "!resources/paper-search-mcp/**",
      "!**/__pycache__/**",
      "!**/*.pyc",
      "!**/uv.lock"
    ],
    "logLevel": "verbose"
  },
  "build": {
    "extends": "electron-builder.yml"
  },
  "asci": {},
  "optionalDependencies": {
    "sqlite-vec-darwin-arm64": "0.1.9",
    "sqlite-vec-darwin-x64": "0.1.9",
    "sqlite-vec-linux-arm64": "0.1.9",
    "sqlite-vec-linux-x64": "0.1.9",
    "sqlite-vec-windows-x64": "0.1.9"
  }
}
