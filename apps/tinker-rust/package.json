{
  "name": "@tinker/rust-desktop",
  "private": true,
  "version": "0.0.19",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5177 --strictPort",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "desktop:dev": "cargo tauri dev",
    "desktop:build": "cargo tauri build --debug",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml -- --test-threads=1",
    "formal:build": "cd ../electron && bunx vite build --config vite.formal.config.ts",
    "formal:desktop:build": "bun run formal:build && bun scripts/build-formal.ts",
    "channels:desktop:build": "bun scripts/build-channels.ts",
    "channels:qa:desktop:build": "bun scripts/build-channels-native-qa.ts"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "vite": "6.4.3",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "typescript": "5.9.3"
  }
}
