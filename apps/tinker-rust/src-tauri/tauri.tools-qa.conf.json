{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tinker Tools Native QA",
  "mainBinaryName": "tinker-tools-native-qa",
  "version": "0.0.1",
  "identifier": "com.tinker.tools-native-qa",
  "build": {
    "frontendDist": "../native-qa-dist",
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "devUrl": null
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost blob:; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' data: blob:; worker-src 'self' blob:; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'",
      "capabilities": [
        {
          "identifier": "formal-main",
          "windows": [
            "main"
          ],
          "permissions": [
            "core:event:allow-listen",
            "core:event:allow-unlisten"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "../../electron/resources/icon.png",
      "../../electron/resources/icon.icns"
    ],
    "resources": {
      "../../../LICENSE": "LICENSE",
      "../../../NOTICE": "NOTICE"
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
