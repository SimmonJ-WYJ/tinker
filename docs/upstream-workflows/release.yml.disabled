# GitHub Actions: automatic packaging and distribution
#
# Trigger: push v* tag (e.g. v0.4.0)
# Build macOS and Windows artifacts and publish to GitHub Releases
#
# macOS signing: temporary ad-hoc signature (no Apple Developer account required)
#   - electron-builder skips Developer ID discovery via CSC_IDENTITY_AUTO_DISCOVERY=false
#   - Artifacts are ad-hoc self-signed; first launch requires right-click Open to pass Gatekeeper
#   - No Apple notarization (ad-hoc does not support it)
# GitHub Actions supplies GITHUB_TOKEN automatically; no manual configuration
#
# Guard: preflight checks whether this tag already has a draft or published release
#   - Actual new tag push → no release → build normally
#   - Manual Publish draft → GitHub creates tag and triggers this workflow → existing release → skip duplicate build
#   Background: After notify-lark-release.yml, publishing drafts creates tags and unexpectedly triggers release.yml

name: Release

on:
  push:
    tags:
      - 'v*'

permissions:
  contents: write

jobs:
  preflight:
    runs-on: ubuntu-latest
    outputs:
      should_build: ${{ steps.check.outputs.should_build }}
    steps:
      - name: Skip if release for this tag already has built assets
        id: check
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          TAG: ${{ github.ref_name }}
          REPO: ${{ github.repository }}
        run: |
          # Query release asset count (draft or published)
          # >0 → built previously (draft awaiting review or duplicate side-effect trigger) → skip
          # =0 → no release / empty assets after failed build → allow build
          ASSET_COUNT=$(gh release view "$TAG" --repo "$REPO" --json assets -q '.assets | length' 2>/dev/null || echo 0)
          if [ "${ASSET_COUNT:-0}" -gt 0 ]; then
            echo "::notice::Release for $TAG already has $ASSET_COUNT asset(s); skipping rebuild"
            echo "should_build=false" >> "$GITHUB_OUTPUT"
          else
            echo "::notice::No release/assets for $TAG; proceeding with build"
            echo "should_build=true" >> "$GITHUB_OUTPUT"
          fi

  build:
    needs: preflight
    if: needs.preflight.outputs.should_build == 'true'
    strategy:
      fail-fast: false
      matrix:
        include:
          - os: macos-latest
            platform: mac
            arch: arm64
            asci-py-target: darwin-arm64
            builder-arch-flag: --arm64
          - os: macos-latest
            platform: mac
            arch: x64
            asci-py-target: darwin-x64
            builder-arch-flag: --x64
          - os: windows-latest
            platform: win
            arch: x64
            asci-py-target: win32-x64
            builder-arch-flag: --x64

    runs-on: ${{ matrix.os }}

    steps:
      - name: 检出代码
        uses: actions/checkout@v6

      - name: 安装 Bun
        uses: oven-sh/setup-bun@v2
        with:
          bun-version: latest

      - name: 安装 Node.js
        uses: actions/setup-node@v6
        with:
          node-version: 20

      - name: 安装依赖
        # @vscode/ripgrep postinstall fetches prebuilt binaries from api.github.com;
        # Without token, unauthenticated quota is 60/hr/IP; GH-hosted runners share egress IPs
        # and receive 403 at peak. GITHUB_TOKEN makes download.js add Authorization,
        # increasing quota to 5000/hr.
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: bun install

      # Cache 4-tool runtime stage (manifest-hash key; cache hit skips downloads)
      - name: 缓存 runtimes
        uses: actions/cache@v5
        with:
          path: apps/electron/dist/runtimes/${{ matrix.asci-py-target }}
          key: runtimes-${{ matrix.asci-py-target }}-${{ hashFiles('apps/electron/scripts/runtimes-manifest.json') }}

      # Stage 4 built-in tools (Node / Git / uv / Python) into dist/runtimes/<arch>/
      # Cache miss downloads and verifies SHA256; cache hit skips
      - name: Stage runtimes
        run: bun run stage:runtimes
        working-directory: apps/electron

      # Build application
      # Committed apps/electron/telemetry.config.json supplies telemetry publishable keys;
      # build-main.ts injects at build time, no extra CI secrets (ADR-011).
      # For temporary rotation without source changes, add env: ASCI_POSTHOG_KEY/ASCI_SENTRY_DSN overrides here.
      - name: 构建 Electron 应用
        run: bun run electron:build
        working-directory: .

      # better-sqlite3 uses legacy V8/NAN bindings tied to NODE_MODULE_VERSION; bun install defaults to Node
      # ABI downloads/builds, which crash on require in Electron main. Rebuild to Electron ABI here:
      # Fast path uses Electron prebuilts, falling back to @electron/rebuild source (rebuild-better-sqlite3.ts).
      # --arch uses matrix.arch, supporting mac x64 cross-builds from arm64 runners.
      - name: 重建 better-sqlite3 到 Electron ABI
        env:
          TARGET_ARCH: ${{ matrix.arch }}
        run: bun run rebuild -- --arch "$TARGET_ARCH"
        working-directory: apps/electron

      # Prepackaging gate: assert better-sqlite3 loads under Electron ABI; mismatch fails to prevent
      # user startup crashes. dlopen requires runner arch == target arch; skip on cross-builds
      # (previous command explicitly ensures Electron ABI for those artifacts).
      - name: 校验 better-sqlite3 ABI 匹配 Electron
        shell: bash
        env:
          TARGET_ARCH: ${{ matrix.arch }}
        working-directory: apps/electron
        run: |
          RUNNER_ARCH="$(node -p process.arch)"
          if [ "$RUNNER_ARCH" != "$TARGET_ARCH" ]; then
            echo "::notice::runner arch=$RUNNER_ARCH ≠ target=$TARGET_ARCH（交叉构建），跳过 dlopen 校验"
            exit 0
          fi
          ELECTRON_RUN_AS_NODE=1 npx electron -e "const p=require('path').dirname(require.resolve('better-sqlite3/package.json'))+'/build/Release/better_sqlite3.node'; process.dlopen({exports:{}}, p); console.log('✅ better-sqlite3 ABI 匹配 Electron')"

      # Package and publish to GitHub Releases
      - name: 打包并发布 (macOS)
        if: matrix.platform == 'mac'
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          # Temporary ad-hoc signing: disable Developer ID discovery so electron-builder self-signs
          CSC_IDENTITY_AUTO_DISCOVERY: 'false'
          ASCI_PY_TARGET: ${{ matrix.asci-py-target }}
        run: npx electron-builder --mac ${{ matrix.builder-arch-flag }} --publish always
        working-directory: apps/electron

      - name: 打包并发布 (Windows)
        if: matrix.platform == 'win'
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          ASCI_PY_TARGET: ${{ matrix.asci-py-target }}
        run: npx electron-builder --win ${{ matrix.builder-arch-flag }} --publish always
        working-directory: apps/electron
