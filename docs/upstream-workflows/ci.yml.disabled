name: CI

# Trigger: pull_request / push (base=main).
# Version bumps moved to local pre-commit (scripts/bump-version-on-commit.mjs),
# pinning origin/main patch+1 at commit time; server auto-resolve / pre-push version gates are gone,
# so the former workflow_run compensation path is removed.
on:
  pull_request:
    branches: [main]
  push:
    branches: [main]

permissions:
  contents: read
  pull-requests: write

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  # Forward event context. Keep ctx indirection (downstream reads needs.ctx.outputs.*) for extensibility:
  # Ordinary pull_request / push leaves head_sha empty; actions/checkout uses the triggering ref.
  ctx:
    name: Resolve Context
    runs-on: ubuntu-latest
    outputs:
      should_run: ${{ steps.resolve.outputs.should_run }}
      head_sha: ${{ steps.resolve.outputs.head_sha }}
    steps:
      - name: Resolve
        id: resolve
        run: |
          set -euo pipefail
          # Ordinary pull_request / push: context comes from the event; empty head_sha uses default ref.
          echo "should_run=true" >> "$GITHUB_OUTPUT"
          echo "::notice::regular path (${{ github.event_name }})"

  verify-email:
    name: Verify Commit Email
    needs: ctx
    if: needs.ctx.outputs.should_run == 'true'
    uses: OPENSCI-Labs/.github/.github/workflows/verify-commit-email.yml@main
    permissions:
      contents: read

  # Any file change runs full CI (typecheck / test / lint / gitleaks).
  # Background (#362): old paths-filter watched only packages/apps/root package.json/bun.lock/root tsconfig,
  # missing per-package tsconfig.json, eslint.config.js / eslint-rules/**, tests/**, bunfig.toml,
  # docs/**, .github/**, scripts/**; those changes silently skipped CI, creating blind spots.
  # Now 'code' is true for every file; retain changes job + if gates for future narrowing.
  changes:
    name: Detect Changes
    needs: ctx
    if: needs.ctx.outputs.should_run == 'true'
    runs-on: ubuntu-latest
    outputs:
      code: ${{ steps.filter.outputs.code }}
    steps:
      - uses: actions/checkout@v6
        with:
          ref: ${{ needs.ctx.outputs.head_sha }}
      - uses: dorny/paths-filter@v4
        id: filter
        with:
          filters: |
            code:
              - '**'

  # Warm the global bun cache serially to avoid simultaneous typecheck/test cache misses
  # downloading dependencies separately. Downstream links locally, reducing install ~14s to ~3-5s.
  prep-deps:
    name: Prep deps
    needs: changes
    if: needs.changes.outputs.code == 'true'
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v6
        with:
          ref: ${{ needs.ctx.outputs.head_sha }}
      - uses: oven-sh/setup-bun@v2
        with:
          bun-version: latest
      - name: Cache bun install
        id: cache
        uses: actions/cache@v5
        with:
          path: ~/.bun/install/cache
          key: bun-${{ runner.os }}-${{ hashFiles('bun.lock') }}
          restore-keys: |
            bun-${{ runner.os }}-
      - name: Populate cache (only on miss)
        if: steps.cache.outputs.cache-hit != 'true'
        run: bun install --frozen-lockfile

  typecheck:
    name: Typecheck
    needs: [ctx, changes, prep-deps]
    if: needs.changes.outputs.code == 'true'
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v6
        with:
          ref: ${{ needs.ctx.outputs.head_sha }}
      - uses: oven-sh/setup-bun@v2
        with:
          bun-version: latest
      # Hit global bun cache populated by prep-deps; install links locally
      - name: Restore bun install cache
        uses: actions/cache@v5
        with:
          path: ~/.bun/install/cache
          key: bun-${{ runner.os }}-${{ hashFiles('bun.lock') }}
          restore-keys: |
            bun-${{ runner.os }}-
      - name: Install dependencies
        run: bun install --frozen-lockfile
      - name: Typecheck (all workspaces)
        run: bun run typecheck

  test:
    name: Test
    needs: [ctx, changes, prep-deps]
    if: needs.changes.outputs.code == 'true'
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v6
        with:
          ref: ${{ needs.ctx.outputs.head_sha }}
      - uses: oven-sh/setup-bun@v2
        with:
          bun-version: latest
      # Same prep-deps key, hitting local cache
      - name: Restore bun install cache
        uses: actions/cache@v5
        with:
          path: ~/.bun/install/cache
          key: bun-${{ runner.os }}-${{ hashFiles('bun.lock') }}
          restore-keys: |
            bun-${{ runner.os }}-
      - name: Install dependencies
        run: bun install --frozen-lockfile
      - name: Run tests
        run: bun test

  # ADR-003 B-6: prohibit hardcoded Tailwind palette classNames; require semantic tokens
  lint:
    name: Lint
    needs: [ctx, changes, prep-deps]
    if: needs.changes.outputs.code == 'true'
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v6
        with:
          ref: ${{ needs.ctx.outputs.head_sha }}
      - uses: oven-sh/setup-bun@v2
        with:
          bun-version: latest
      - name: Restore bun install cache
        uses: actions/cache@v5
        with:
          path: ~/.bun/install/cache
          key: bun-${{ runner.os }}-${{ hashFiles('bun.lock') }}
          restore-keys: |
            bun-${{ runner.os }}-
      - name: Install dependencies
        run: bun install --frozen-lockfile
      - name: Lint
        run: bun run lint

  # Dependency scanning (#418 / PRD 0.3.0 §V Security, Operations): high+ vulnerabilities block PRs.
  # Reuse prep-deps global bun cache for local linking. No --ignore exemptions:
  # Existing vulnerabilities fixed in root package.json overrides; newly disclosed high flaws block immediately.
  audit:
    name: Dependency Audit
    needs: [ctx, changes, prep-deps]
    if: needs.changes.outputs.code == 'true'
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v6
        with:
          ref: ${{ needs.ctx.outputs.head_sha }}
      - uses: oven-sh/setup-bun@v2
        with:
          bun-version: latest
      - name: Restore bun install cache
        uses: actions/cache@v5
        with:
          path: ~/.bun/install/cache
          key: bun-${{ runner.os }}-${{ hashFiles('bun.lock') }}
          restore-keys: |
            bun-${{ runner.os }}-
      - name: Install dependencies
        run: bun install --frozen-lockfile
      - name: Audit (block high+ vulnerabilities)
        run: bun audit --audit-level=high

  gitleaks:
    name: Secret Scan
    needs: ctx
    if: needs.ctx.outputs.should_run == 'true'
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v6
        with:
          ref: ${{ needs.ctx.outputs.head_sha }}
          fetch-depth: 0
      - name: Install gitleaks
        run: |
          curl -sSfL https://github.com/gitleaks/gitleaks/releases/download/v8.24.3/gitleaks_8.24.3_linux_x64.tar.gz | tar xz -C /usr/local/bin gitleaks
      - name: Run gitleaks (pull request)
        if: github.event_name == 'pull_request'
        run: |
          gitleaks detect --source . --verbose \
            --log-opts="${{ github.event.pull_request.base.sha }}..${{ github.event.pull_request.head.sha }}"
      - name: Run gitleaks (push)
        if: github.event_name == 'push'
        run: |
          gitleaks detect --source . --verbose \
            --log-opts="${{ github.event.before }}..${{ github.sha }}"

  # Guard: ordinary PRs must not bump apps/electron/package.json.version to prerelease (-rc.N, etc.)
  # Background: 0.x.y CLAUDE.md requires patch bumps for changed packages; -rc.N is reserved for
  # release-agent chore/release-* PRs. An ordinary PR once accidentally bumped to 0.1.179-rc.8.
  # Fail only when this PR changes version to prerelease and is not chore/release-*, avoiding false positives.
  version-lint:
    name: Version Lint
    needs: ctx
    if: needs.ctx.outputs.should_run == 'true' && github.event_name != 'push'
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v6
        with:
          ref: ${{ needs.ctx.outputs.head_sha }}
          fetch-depth: 0   # Need base commit locally for git show "$BASE_SHA:..."
      - name: Disallow prerelease version in non-release PRs
        env:
          HEAD_REF: ${{ github.head_ref }}
          BASE_SHA: ${{ github.event.pull_request.base.sha }}
        run: |
          HEAD_VERSION=$(jq -r '.version' apps/electron/package.json)
          BASE_VERSION=$(git show "$BASE_SHA:apps/electron/package.json" | jq -r '.version')
          echo "base version : $BASE_VERSION"
          echo "head version : $HEAD_VERSION"
          echo "head branch  : $HEAD_REF"
          # Release PRs (chore/release-*) may use -rc.N
          if [[ "$HEAD_REF" == chore/release-* ]]; then
            echo "::notice::Release branch — prerelease suffix allowed."
            exit 0
          fi
          # Fail only if this PR changed version and the new value is prerelease
          if [[ "$HEAD_VERSION" != "$BASE_VERSION" && "$HEAD_VERSION" == *-* ]]; then
            echo "::error::普通 PR 不得把版本号 bump 成 prerelease 形式（'$BASE_VERSION' → '$HEAD_VERSION'）。请改为 plain patch（如 0.1.180 → 0.1.181），不要碰 -rc.N 后缀；-rc.N 只能由发版 agent 的 chore/release-* PR 添加。详见 docs/release-playbook.md §3.1.1。"
            exit 1
          fi
          echo "::notice::Version OK."

  # Gate job: use as the sole required branch-protection status check
  # Jobs skipped by path filters do not block merging
  ci-status:
    name: CI Status
    if: always()
    needs: [ctx, verify-email, changes, prep-deps, typecheck, test, lint, audit, gitleaks, version-lint]
    runs-on: ubuntu-latest
    steps:
      - name: Evaluate
        id: eval
        if: needs.ctx.outputs.should_run == 'true'
        run: |
          if [[ "${{ contains(needs.*.result, 'failure') || contains(needs.*.result, 'cancelled') }}" == "true" ]]; then
            echo "result=failure" >> "$GITHUB_OUTPUT"
          else
            echo "result=success" >> "$GITHUB_OUTPUT"
          fi
      - name: Fail if any job failed
        if: needs.ctx.outputs.should_run == 'true' && steps.eval.outputs.result == 'failure'
        run: |
          echo "::error::One or more CI jobs failed or were cancelled"
          exit 1
